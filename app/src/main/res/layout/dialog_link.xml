<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/linkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://… (.mp4, .m3u8, .webm)"
        android:importantForAutofill="no"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/linkTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Title (optional)"
        android:importantForAutofill="no"
        android:inputType="text" />

    <CheckBox
        android:id="@+id/linkLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is a live stream" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Direct video links only. Normal web pages won't play — use Chrome's Cast feature for those."
        android:textSize="12sp" />
</LinearLayout>
